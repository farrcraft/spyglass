<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>spyglass: third-party licenses</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; line-height: 1.4; }
      pre { white-space: pre-wrap; background: #f4f4f4; padding: 1em; overflow-x: auto; }
      li.license { list-style: none; margin-top: 2em; }
    </style>
  </head>
  <body>
    <h1>Third-party licenses</h1>
    <p>
      spyglass is under the MIT license (see LICENSE). Its binaries include the crates below, each
      under the license shown. Minecraft's code and data are not part of spyglass and are not
      included.
    </p>
    <h2>Licenses used</h2>
    <ul>
      {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
      {{/each}}
    </ul>
    <h2>License texts</h2>
    <ul>
      {{#each licenses}}
      <li class="license">
        <h3 id="{{id}}">{{name}}</h3>
        <p>Used by:</p>
        <ul>
          {{#each used_by}}
          <li>
            <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>
          </li>
          {{/each}}
        </ul>
        <pre>{{text}}</pre>
      </li>
      {{/each}}
    </ul>
  </body>
</html>
